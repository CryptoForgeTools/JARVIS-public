# Personalization (used in greetings and assistant context)
JARVIS_USER_NAME=friend
JARVIS_USER_DETAILS=

# Local model services
JARVIS_OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_URL=http://localhost:11434
JARVIS_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
JARVIS_TTS_SPEAKER=Ryan
JARVIS_TTS_LANGUAGE=English

# Paths may be absolute or relative to this machine. Sherpa model is downloaded separately.
JARVIS_SHERPA_MODEL_DIR=models/sherpa-onnx-nemotron
JARVIS_VOICE_PROFILE_PATH=listeners/voice_profile.npy
JARVIS_FACE_CONFIG_PATH=camera/face_model.pkl
JARVIS_FACE_MODEL_PATH=camera/face_model.yml
JARVIS_FACE_DETECTOR_CONFIG=camera/deploy.prototxt
JARVIS_FACE_DETECTOR_MODEL=models/face/res10_300x300_ssd_iter_140000.caffemodel
JARVIS_MEMORY_PATH=memory/memory.json
JARVIS_WAKEWORD_MODEL=hey_jarvis

# Optional voice cloning: leave blank to use the built-in custom voice.
JARVIS_TTS_REFERENCE_AUDIO=
JARVIS_TTS_REFERENCE_TEXT=
